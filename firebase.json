{
  "hosting": {
    "public": "build",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/wasm/**",
        "destination": "/wasm/index.html"
      },
      {
        "source": "/js/**",
        "destination": "/js/index.html"
      }
    ]
  }
}
